# Environment configuration for NemoLearn (Production Ready)

# ==============================================================================
# 1. APPLICATION
# ==============================================================================
NEXT_PUBLIC_APP_NAME="NemoLearn"
NEXT_PUBLIC_APP_URL="https://nemolearn.vercel.app"
NODE_ENV="production"

# ==============================================================================
# 2. SUPABASE / PRODUCTION POSTGRESQL DATABASE
# ==============================================================================
# Public project URL and Anonymous client key (Safe to expose on client side)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token"

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER PREFIX WITH NEXT_PUBLIC_)
# Used exclusively by backend API routes for authoritative DB sync and migrations
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-token"

# Optional direct PostgreSQL connection string (for migrations / CLI)
DATABASE_URL="postgresql://postgres:postgres@db.your-project.supabase.co:5432/postgres"

# ==============================================================================
# 3. AUTHENTICATION & SECURITY
# ==============================================================================
# Secret used for session cookie signing (HMAC SHA-256) and RBAC verification
# Must be a secure random string with minimum 32 characters
AUTH_SECRET="change-this-to-a-cryptographically-secure-random-string-at-least-32-chars"

# Optional Google OAuth client configuration (P1)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==============================================================================
# 4. AI PROVIDER CONFIGURATION
# ==============================================================================
# Supported providers: "gemini", "openai", "openai-compatible", "mock"
AI_PROVIDER="gemini"

# Google Gemini (Primary Production Engine)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# OpenAI & OpenAI-Compatible (Groq, OpenRouter, Together AI, local vLLM/Ollama)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Optional: Set custom base URL for OpenAI-compatible providers
# Examples:
#   Groq: https://api.groq.com/openai/v1 (model: llama-3.3-70b-versatile)
#   OpenRouter: https://openrouter.ai/api/v1 (model: deepseek/deepseek-chat)
# Note: Private/loopback IP addresses (127.0.0.1, 169.254.x, localhost) are blocked for SSRF safety.
OPENAI_BASE_URL="https://api.openai.com/v1"

# ==============================================================================
# 5. AI GENERATION CONTROLS & GUARDRAILS
# ==============================================================================
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_MAX_QUESTIONS_PER_REQUEST=30
